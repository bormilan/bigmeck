{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [{meck, "1.2.0"}]}.

{project_plugins, [
    {rebar3_lint, "5.0.4"},
    {erlfmt, "1.8.0"}
]}.

{erlfmt, [
    write,
    {files, ["{src,include,test}/**/*.{erl,hrl,app.src}", "*.config"]}
]}.

{alias, [{check, [{fmt, "--check"}, compile, eunit, lint]}]}.
